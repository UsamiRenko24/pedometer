<?xml version="1.0" encoding="utf-8"?>
<com.demo.app.launcher.ui.adapter.calendar.CalendarEventRow xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/calendar_event_delete"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/bg_calendar_trash"
        android:contentDescription="@string/calendar_delete_confirm"
        android:padding="10dp"
        android:src="@drawable/ic_calendar_trash" />

    <LinearLayout
        android:id="@+id/calendar_event_card"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <View
            android:id="@+id/calendar_event_bar"
            android:layout_width="4dp"
            android:layout_height="28dp" />

        <TextView
            android:id="@+id/calendar_event_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/color_1C1C1E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/calendar_event_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/color_9A9A9A"
            android:textSize="13sp" />
    </LinearLayout>
</com.demo.app.launcher.ui.adapter.calendar.CalendarEventRow>
