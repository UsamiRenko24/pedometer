<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weather_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F4F7FC">

    <ImageView
        android:id="@+id/weather_search_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/content_back"
        android:padding="8dp"
        android:src="@drawable/icon_home_app_weather_left_black" />

    <RelativeLayout
        android:id="@+id/weather_search_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_toEndOf="@id/weather_search_back"
        android:background="@drawable/bg_weather_manage_card">

        <ImageView
            android:id="@+id/weather_search_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/weather_manage_search"
            android:src="@drawable/icon_home_app_weather_search_black" />

        <EditText
            android:id="@+id/weather_search_input"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@id/weather_search_icon"
            android:background="@null"
            android:hint="@string/weather_manage_search"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/color_1C2430"
            android:textColorHint="@color/color_C3CDD8"
            android:textSize="16sp" />
    </RelativeLayout>

    <ScrollView
        android:id="@+id/weather_search_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/weather_search_bar"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/weather_search_recommend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="4dp"
                    android:text="@string/weather_search_popular"
                    android:textColor="@color/color_9AA6B5"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/weather_search_recommend_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/weather_search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/weather_search_fail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="120dp"
                    android:contentDescription="@null"
                    android:src="@drawable/icon_home_app_weather_load_fail" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/weather_search_load_fail"
                    android:textColor="@color/color_8B95A5"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/weather_search_reload"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_weather_reload"
                    android:gravity="center"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:text="@string/weather_search_reload"
                    android:textColor="@color/color_216AFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/weather_search_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="120dp"
                    android:contentDescription="@null"
                    android:src="@drawable/icon_home_app_weather_location_no_found" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/weather_search_not_found"
                    android:textColor="@color/color_8B95A5"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/weather_search_network"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="120dp"
                    android:contentDescription="@null"
                    android:src="@drawable/icon_home_app_weather_network_error" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/weather_search_no_network"
                    android:textColor="@color/color_8B95A5"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</RelativeLayout>
