<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="18dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="18dp"
    android:background="@drawable/bg_discover_card"
    android:padding="12dp">

    <ImageView
        android:id="@+id/discover_row_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_discover_icon"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/discover_row_play"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/bg_discover_play"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/discover_play"
        android:textColor="@color/color_white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/discover_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/color_1C1C1E"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/discover_row_play"
        app:layout_constraintStart_toEndOf="@id/discover_row_icon"
        app:layout_constraintTop_toTopOf="@id/discover_row_icon" />

    <ImageView
        android:id="@+id/discover_row_star"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_discover_star"
        app:layout_constraintStart_toStartOf="@id/discover_row_name"
        app:layout_constraintTop_toBottomOf="@id/discover_row_name" />

    <TextView
        android:id="@+id/discover_row_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="@color/color_A1ADC8"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/discover_row_star"
        app:layout_constraintStart_toEndOf="@id/discover_row_star"
        app:layout_constraintTop_toTopOf="@id/discover_row_star" />

    <TextView
        android:id="@+id/discover_row_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/color_A1ADC8"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@id/discover_row_play"
        app:layout_constraintStart_toStartOf="@id/discover_row_name"
        app:layout_constraintTop_toBottomOf="@id/discover_row_star" />
</androidx.constraintlayout.widget.ConstraintLayout>
