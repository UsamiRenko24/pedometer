<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F8F9FB"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/screen0_folder"
            android:textColor="@color/color_1C1C1E"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/folder_toolbar_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/folder_search"
            android:padding="8dp"
            android:src="@drawable/icon_home_app_folder_search" />

        <ImageView
            android:id="@+id/folder_toolbar_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/icon_home_app_folder_menu" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/folder_search_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_folder_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/folder_search"
            android:textColor="@color/color_C7C7CC"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/icon_home_app_folder_voice_input" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/icon_home_app_folder_menu" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginTop="-6dp"
                android:layout_marginEnd="-6dp"
                android:columnCount="3">

                <LinearLayout
                    android:id="@+id/folder_cat_images"
                    style="@style/FolderCategoryCell"
                    android:backgroundTint="@color/color_F1EFFE">

                    <ImageView
                        style="@style/FolderCategoryIcon"
                        android:src="@drawable/icon_home_app_folder_images" />

                    <TextView
                        style="@style/FolderCategoryLabel"
                        android:text="@string/folder_images" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/folder_cat_video"
                    style="@style/FolderCategoryCell"
                    android:backgroundTint="@color/color_EEF5FD">

                    <ImageView
                        style="@style/FolderCategoryIcon"
                        android:src="@drawable/icon_home_app_folder_video" />

                    <TextView
                        style="@style/FolderCategoryLabel"
                        android:text="@string/folder_video" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/folder_cat_music"
                    style="@style/FolderCategoryCell"
                    android:backgroundTint="@color/color_FDEFF3">

                    <ImageView
                        style="@style/FolderCategoryIcon"
                        android:src="@drawable/icon_home_app_folder_music" />

                    <TextView
                        style="@style/FolderCategoryLabel"
                        android:text="@string/folder_music" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/folder_cat_files"
                    style="@style/FolderCategoryCell"
                    android:backgroundTint="@color/color_FDF6EB">

                    <ImageView
                        style="@style/FolderCategoryIcon"
                        android:src="@drawable/icon_home_app_folder_files" />

                    <TextView
                        style="@style/FolderCategoryLabel"
                        android:text="@string/folder_files" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/folder_cat_download"
                    style="@style/FolderCategoryCell"
                    android:backgroundTint="@color/color_E0F6F3">

                    <ImageView
                        style="@style/FolderCategoryIcon"
                        android:src="@drawable/icon_home_app_folder_main_download" />

                    <TextView
                        style="@style/FolderCategoryLabel"
                        android:text="@string/folder_download" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/folder_cat_apk"
                    style="@style/FolderCategoryCell"
                    android:backgroundTint="@color/color_EEFAED">

                    <ImageView
                        style="@style/FolderCategoryIcon"
                        android:src="@drawable/icon_home_app_folder_apk" />

                    <TextView
                        style="@style/FolderCategoryLabel"
                        android:text="@string/folder_apk" />
                </LinearLayout>
            </GridLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/folder_storage"
                android:textColor="@color/color_1C1C1E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_folder_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            android:src="@drawable/icon_home_app_folder_download" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/folder_storage_phone"
                            android:textColor="@color/color_1C1C1E"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/folder_phone_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/color_9A9A9A"
                        android:textSize="12sp" />

                    <ProgressBar
                        android:id="@+id/folder_phone_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progressDrawable="@drawable/bg_folder_progress_phone" />

                    <TextView
                        android:id="@+id/folder_phone_percent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="end"
                        android:textColor="@color/color_9A9A9A"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_folder_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            android:src="@drawable/icon_home_app_folder_sdcard" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/folder_sd_card"
                            android:textColor="@color/color_1C1C1E"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/folder_sd_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/color_9A9A9A"
                        android:textSize="12sp" />

                    <ProgressBar
                        android:id="@+id/folder_sd_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progressDrawable="@drawable/bg_folder_progress_sd" />

                    <TextView
                        android:id="@+id/folder_sd_percent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="end"
                        android:textColor="@color/color_9A9A9A"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/folder_recent_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/folder_recent"
                android:textColor="@color/color_1C1C1E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/folder_permission"
                layout="@layout/view_folder_permission_banner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/folder_recent_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
