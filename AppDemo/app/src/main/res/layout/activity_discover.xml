<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/discover_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F5F5F7"
    android:orientation="vertical">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/discover_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_EEEEEE" />

    <LinearLayout
        android:id="@+id/discover_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_white"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/discover_tab_explore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/discover_tab_explore_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/discover_tab_explore"
                android:src="@drawable/icon_home_app_discover_navigation_explore_selected" />

            <TextView
                android:id="@+id/discover_tab_explore_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/discover_tab_explore"
                android:textColor="@color/color_4F7CFB"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/discover_tab_apps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/discover_tab_apps_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/discover_tab_apps"
                android:src="@drawable/icon_home_app_discover_navigation_apps_unselected" />

            <TextView
                android:id="@+id/discover_tab_apps_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/discover_tab_apps"
                android:textColor="@color/color_A1ADC8"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/discover_tab_games"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/discover_tab_games_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/discover_tab_games"
                android:src="@drawable/icon_home_app_discover_navigation_games_unselected" />

            <TextView
                android:id="@+id/discover_tab_games_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/discover_tab_games"
                android:textColor="@color/color_A1ADC8"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
