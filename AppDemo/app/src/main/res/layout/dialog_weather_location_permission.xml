<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_weather_permission_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:contentDescription="@null"
        android:src="@drawable/icon_home_app_weather_request_location" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/weather_permission_title"
        android:textColor="@color/color_1C2430"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/weather_permission_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/color_8B95A5"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/weather_permission_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_weather_permission_cancel"
            android:gravity="center"
            android:text="@string/weather_permission_cancel"
            android:textColor="@color/color_9AA3B2"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/weather_permission_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_weather_permission_confirm"
            android:gravity="center"
            android:text="@string/weather_permission_confirm"
            android:textColor="@color/color_white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
