<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_note_splash">

    <LinearLayout
        android:id="@+id/note_splash_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.demo.app.launcher.ui.view.splash.SplashIconView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/screen0_note"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_home_app_note_splash" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/screen0_note"
            android:textColor="@color/color_1D0E08"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.35" />

        <ProgressBar
            android:id="@+id/note_splash_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="88dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/bg_note_splash_progress" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/launcher_flSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
