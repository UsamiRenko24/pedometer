<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/news_article_image"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_news_skeleton"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/icon_home_app_news_detail_img" />

    <TextView
        android:id="@+id/news_article_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/color_1C2430"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/news_article_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/color_9AA3B2"
        android:textSize="12sp" />
</LinearLayout>
