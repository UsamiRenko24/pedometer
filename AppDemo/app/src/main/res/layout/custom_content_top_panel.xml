<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F8F9FB"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/globalSearch_greeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/globalSearch_tvDailyEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/search_daily_edit_label"
            android:textAllCaps="true"
            android:textColor="@color/color_9AA0A6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/globalSearch_tvGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/color_1C1C1E"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/globalSearch_tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/search_greeting_subtitle"
            android:textColor="@color/color_9AA0A6"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/globalSearch_ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/content_back"
            android:padding="8dp"
            android:src="@drawable/arrow_left"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <EditText
                android:id="@+id/globalSearch_etInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_screen0_predicted_card"
                android:drawableStart="@drawable/ic_folder_search"
                android:drawablePadding="8dp"
                android:drawableTint="@color/color_9AA0A6"
                android:hint="@string/screen0_search_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="44dp"
                android:textColor="@color/color_333333"
                android:textColorHint="@color/color_9C9C9C"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/globalSearch_ivVoice"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/screen0_search_hint"
                android:padding="6dp"
                android:src="@drawable/launcher_search_voice" />
        </FrameLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/globalSearch_shortcuts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp" />

    <FrameLayout
        android:id="@+id/globalSearch_flView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
