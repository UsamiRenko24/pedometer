<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_screen0_menu"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <LinearLayout
        android:id="@+id/screen0_menu_home_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minWidth="180dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/screen0_home_settings"
            android:src="@drawable/ic_screen0_home_settings" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/screen0_home_settings"
            android:textColor="@color/color_1C1C1E"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/screen0_menu_widgets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minWidth="180dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/screen0_widgets"
            android:src="@drawable/ic_screen0_widgets" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/screen0_widgets"
            android:textColor="@color/color_1C1C1E"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
