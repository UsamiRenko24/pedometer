<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nativeAdCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ad_card"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- AD 标签 -->
    <TextView
        android:id="@+id/tvAdBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ad_badge"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="@string/ad_badge"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- 媒体图片区域 -->
    <FrameLayout
        android:id="@+id/adMediaContainer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_ad_image">

        <ImageView
            android:id="@+id/ivAdMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- 底部：图标 + 标题/副标题 + 安装按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivAdIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_ad_image"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAdTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ad_title"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ad_subtitle"
                android:textColor="@color/color_A1ADC8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnAdInstall"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_install_button"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/ad_install"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
