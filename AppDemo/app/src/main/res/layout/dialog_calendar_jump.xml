<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_calendar_dialog"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="22dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/calendar_jump_title"
        android:textColor="@color/color_1C1C1E"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/calendar_jump_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/color_C5CBD7"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <NumberPicker
            android:id="@+id/calendar_jump_year"
            android:layout_width="0dp"
            android:layout_height="168dp"
            android:layout_weight="1"
            android:theme="@style/CalendarJumpPicker" />

        <NumberPicker
            android:id="@+id/calendar_jump_month"
            android:layout_width="0dp"
            android:layout_height="168dp"
            android:layout_weight="1"
            android:theme="@style/CalendarJumpPicker" />

        <NumberPicker
            android:id="@+id/calendar_jump_day"
            android:layout_width="0dp"
            android:layout_height="168dp"
            android:layout_weight="1"
            android:theme="@style/CalendarJumpPicker" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/calendar_jump_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_calendar_cancel"
            android:gravity="center"
            android:text="@string/calendar_cancel"
            android:textColor="@color/color_7D8AA5"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/calendar_jump_confirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_calendar_today"
            android:gravity="center"
            android:text="@string/calendar_confirm"
            android:textColor="@color/color_white"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
