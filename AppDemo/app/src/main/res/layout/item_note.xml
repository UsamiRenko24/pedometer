<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/note_item_card"
        android:layout_width="match_parent"
        android:layout_height="148dp"
        android:background="@drawable/bg_note_card"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/note_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/color_1C1C1E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/note_item_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/color_9A9A9A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/note_item_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/color_696969"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/note_item_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="end"
            android:contentDescription="@null"
            android:src="@drawable/icon_home_app_note_unselect" />
    </LinearLayout>
</FrameLayout>
