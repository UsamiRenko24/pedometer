<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F5F5F7">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/discover_feed_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="8dp"
        android:paddingBottom="12dp" />

    <ProgressBar
        android:id="@+id/discover_feed_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/discover_feed_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/discover_no_network"
        android:textColor="@color/color_8B95A5"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
